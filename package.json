{
  "name": "renovo-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:front": "vite",
    "build": "vite build",
    "check": "tsc -b",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply renovo-hub --local",
    "db:seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
